    <div class="d-grid gap-2">
        <button id="nextButton" class="btn btn-custom-blue" type="button" style="width: 500px; margin-bottom: 100px">Next</button>
    </div>
</div> *@

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
